# ============================================================
# 复制本文件为 .env.local 并填入真实值；真实密钥永不提交进 git
# 移交时通过密码管理器等安全渠道交付，并轮换全部旧 Key
# ============================================================

# ===== AI Gateway（公司网关，可选）=====
# 不配置也能跑：未配置时生成/审校会明确报错，但资料识别、编辑、版本、导出不受影响。
# 支持 anthropic-compatible 或 openai-compatible；按公司网关协议选择
AI_PROVIDER=anthropic-compatible
# 可填写网关根地址，也兼容填写完整的 /v1/messages 或 /v1/chat/completions 地址
AI_BASE_URL=
AI_API_KEY=
# 默认按协议使用 x-api-key(Anthropic) / Bearer(OpenAI)；公司网关特殊时可填 x-api-key 或 bearer
AI_AUTH_MODE=
# temperature 默认不发送：部分模型/网关会以 400 拒绝该参数。
# 确认所用模型支持时再填数字（例如 0.2），否则保持留空。
AI_TEMPERATURE=

# 模型路由：同一 Key，按任务传不同 model
AI_MODEL_GENERATION=
AI_MODEL_REVIEW=
AI_MODEL_VISION=

# ===== 本地工作区 =====
# 教材业务数据的唯一事实源（profile.md §3）。留空使用默认位置：
#   %USERPROFILE%\Documents\AI教材工作台
# 一般不需要设置；多工作区切换或测试时才有用。
# AI_TEACHING_WORKSPACE=

# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# 说明：本版是安装到老师电脑上的本地个人工具。
# 不再有远程业务数据库、对外 REST API、账户体系或协作锁；
# 教材原始文件、OCR 结果、规则、版本与审校记录全部保存在本地工作区。
# ============================================================
