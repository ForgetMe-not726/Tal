# ============================================================
# 复制本文件为 .env.local 并填入真实值;真实密钥永不提交进 git
# 移交时通过密码管理器等安全渠道交付,并轮换全部旧 Key
# ============================================================

# ===== Supabase(项目设置 → API 页获取)=====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 服务端专用,绝不能暴露到浏览器端
SUPABASE_SERVICE_ROLE_KEY=

# ===== AI Gateway(公司网关,Anthropic 兼容协议)=====
AI_PROVIDER=anthropic-compatible
AI_BASE_URL=
AI_API_KEY=

# 模型路由(profile.md 第三十节):同一 Key,按任务传不同 model
AI_MODEL_GENERATION=
AI_MODEL_REVIEW=
AI_MODEL_VISION=
# 未来 Cambridge/RAG 语义检索用(Phase 2 接入时启用)
# AI_MODEL_EMBEDDING=

# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
